# Copy to .env and fill in. Every one of these must also be set in Vercel
# (Project -> Settings -> Environment Variables) for Production and Preview.

# Pooled Postgres connection the app runs on. On Neon this is the host with
# "-pooler" in it; on Supabase it is the connection string on port 6543.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Unpooled connection, used only by `prisma migrate` during the build.
# Same database, without the "-pooler" (Supabase: port 5432). Neon's Vercel
# integration sets this one for you; locally it can equal DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Signs session cookies. Must be at least 32 characters, and must be the same
# value across deploys or everyone gets signed out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
